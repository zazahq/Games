----------------------------------------------------------------
-- helpers
----------------------------------------------------------------
local function isBlacklisted(part)
	local t = blacklist[part]
	if not t then return false end
	if os.clock() > t then
		blacklist[part] = nil
		return false
	end
	return true
end

local function addToBlacklist(part)
	if part then
		blacklist[part] = os.clock() + BLACKLIST_TIME
		print("[Mecanico] blacklist 45s →", part.Name)
	end
end

MecanicoRemote.OnClientEvent:Connect(function(action, data)
	if action == "Aviso" and data and data.texto then
		local txt = tostring(data.texto):lower()
		if txt:find("otro mecánico") or txt:find("otro mecanico") or txt:find("ya está con ese") then
			addToBlacklist(currentBass)
		end
	end
end)

local attachTo, detach

detach = function()
	if attachConn then
		attachConn:Disconnect()
		attachConn = nil
	end
	attachedPart = nil
end

attachTo = function(part, offset)
	detach()
	if not part then return end
	attachedPart = part
	attachOffset = offset or Vector3.new(0, 2.6, 0)
	attachConn = RunService.Heartbeat:Connect(function()
		local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not hrp or not attachedPart or not attachedPart.Parent then
			detach()
			return
		end
		local target = attachedPart.CFrame * CFrame.new(attachOffset)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = target
	end)
end

local function getHRP()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function firePrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return false end
	if not prompt.Enabled then return false end
	pcall(function() fireproximityprompt(prompt) end)
	return true
end

local function isOnDuty()
	return LocalPlayer:GetAttribute("EsMecanico") == true
end

local function doFichaje()
	if isOnDuty() then return true end
	local hrp = getHRP()
	if not hrp then return false end
	detach()
	hrp.CFrame = CFrame.new(FICHAJE_POS)
	task.wait(0.7)
	local prompt = nil
	for _, child in ipairs(PUESTOS:GetChildren()) do
		if child.Name:lower():find("fichaje") then
			local p = child:FindFirstChild("PromptFichaje") or child:FindFirstChildWhichIsA("ProximityPrompt")
			if p and p:IsA("ProximityPrompt") then
				prompt = p
				break
			end
		end
	end
	if prompt then
		firePrompt(prompt)
		task.wait(1.4)
	end
	return isOnDuty()
end

local function findDamagedBass()
	for _, veh in ipairs(VEHICLES:GetChildren()) do
		if veh.Name:match("^Taller") then
			for _, part in ipairs(veh:GetDescendants()) do
				if part:IsA("BasePart") and part.Name:match("^PuestoBajo_Bass") then
					if isBlacklisted(part) then continue end
					local prompt = part:FindFirstChildWhichIsA("ProximityPrompt")
					if prompt and prompt.Enabled then
						return part, prompt, veh
					end
				end
			end
		end
	end
	return nil, nil, nil
end

local function getMesaPrompt()
	for _, child in ipairs(PUESTOS:GetChildren()) do
		if child.Name == "Mesa" then
			local p = child:FindFirstChild("Prompt") or child:FindFirstChildWhichIsA("ProximityPrompt")
			if p and p:IsA("ProximityPrompt") and p.Enabled then
				return p, child
			end
		end
	end
	return nil, nil
end

local function getRackPrompt()
	local rack = PUESTOS:FindFirstChild("Rack")
	if rack then
		local p = rack:FindFirstChild("Prompt") or rack:FindFirstChildWhichIsA("ProximityPrompt")
		if p and p:IsA("ProximityPrompt") then
			return p, rack
		end
	end
	return nil, nil
end

local function repairOne()
	local bassPart = currentBass
	local removePrompt = nil

	if not holdingBass then
		bassPart, removePrompt = findDamagedBass()
		if not bassPart then
			return false, "sin bajos libres"
		end
		currentBass = bassPart
	else
		print("[Mecanico] continuando ciclo con bajo en mano →", bassPart and bassPart.Name)
	end

	print("[Mecanico] Bajo →", bassPart:GetFullName())

	if not holdingBass then
		attachTo(bassPart, Vector3.new(0, 2.6, 0))
		task.wait(0.35)
		if removePrompt then
			firePrompt(removePrompt)
		else
			local p = bassPart:FindFirstChildWhichIsA("ProximityPrompt")
			if p then firePrompt(p) end
		end
		print("[Mecanico] quitando bajo dañado... (7s)")
		task.wait(REMOVE_WAIT)

		if isBlacklisted(bassPart) then
			print("[Mecanico] otro mecánico se lo quedó")
			detach()
			currentBass = nil
			holdingBass = false
			return false, "ocupado"
		end

		holdingBass = true
		print("[Mecanico] bajo quitado (en mano)")
	end

	detach()
	local mesaPrompt, mesa = getMesaPrompt()
	if mesaPrompt then
		local mesaPart = mesa:IsA("BasePart") and mesa or mesa:FindFirstChildWhichIsA("BasePart")
		if mesaPart then
			attachTo(mesaPart, Vector3.new(0, 3.2, 0))
			task.wait(0.3)
		end
		firePrompt(mesaPrompt)
		print("[Mecanico] puesto en mesa")
		task.wait(1.5)
		detach()
	else
		warn("[Mecanico] no se encontró Prompt de Mesa")
	end

	local rackPrompt, rack = getRackPrompt()
	if rackPrompt then
		local rackPart = rack:IsA("BasePart") and rack or rack:FindFirstChildWhichIsA("BasePart")
		if rackPart then
			attachTo(rackPart, Vector3.new(0, 3.0, 0))
			task.wait(0.3)
		end
		firePrompt(rackPrompt)
		print("[Mecanico] bajo nuevo agarrado")
		task.wait(1.3)
		detach()
	else
		warn("[Mecanico] no se encontró Prompt del Rack")
	end

	local installPrompt = nil
	for i = 1, 20 do
		installPrompt = bassPart:FindFirstChildWhichIsA("ProximityPrompt")
		if installPrompt and installPrompt.Enabled then break end
		task.wait(0.25)
	end

	attachTo(bassPart, Vector3.new(0, 2.6, 0))
	task.wait(0.35)
	if installPrompt then
		firePrompt(installPrompt)
		print("[Mecanico] instalando bajo nuevo... (8s)")
		task.wait(INSTALL_WAIT)
		print("[Mecanico] instalación terminada")
	else
		warn("[Mecanico] no apareció prompt de instalación")
	end

	detach()
	holdingBass = false
	currentBass = nil
	task.wait(1.2)
	return true, "ok"
end

local function startFarm()
	if running then return end
	running = true
	print("[Mecanico] farm ACTIVADO")

	farmThread = task.spawn(function()
		while running do
			if not getHRP() then
				task.wait(1)
				continue
			end

			if not isOnDuty() then
				print("[Mecanico] fichando...")
				doFichaje()
				task.wait(1.5)
				continue
			end

			local ok, msg = repairOne()
			if not ok then
				print("[Mecanico]", msg)
				if holdingBass then
					print("[Mecanico] reintentando ciclo con bajo en mano...")
					task.wait(1)
				else
					task.wait(2.5)
				end
			else
				task.wait(1.2)
			end
		end
		detach()
	end)
end

local function stopFarm()
	running = false
	detach()
	holdingBass = false
	currentBass = nil
	print("[Mecanico] farm DESACTIVADO")
end

